{
  "manifest_version": 3,
  "name": "YouTube Playlist Focus",
  "version": "2.2.0",
  "description": "Distraction-free YouTube experience. Replace home feed & recommendations with your custom playlists, Watch Later, and curated sidebar.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "next-video": {
      "suggested_key": { "default": "Alt+N" },
      "description": "Play next video in playlist"
    },
    "prev-video": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Play previous video in playlist"
    },
    "goto-homepage": {
      "suggested_key": { "default": "Alt+H" },
      "description": "Go to playlist focus homepage"
    },
    "focus-search": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Focus playlist search bar"
    }
  }
}
